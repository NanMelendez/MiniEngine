{
	"version": "2.0.0",
	"tasks": [
        // Pre-compiled header tasks
        {
            "type": "cppbuild",
            "label": "PCH Compile (Debug)",
            "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "-std=c++20",
                "-I${workspaceFolder}/include",
                "-g",
                "${workspaceFolder}/src/MiniEngine/pch.hpp"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "type": "cppbuild",
            "label": "PCH Compile (Release)",
            "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "-std=c++20",
                "-I${workspaceFolder}/include",
                "-O3",
                "${workspaceFolder}/src/MiniEngine/pch.hpp"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        // Main build tasks
		{
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file (Debug)",
            "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-std=c++20",
                "-I${workspaceFolder}/include",
                "-L${workspaceFolder}/lib",
                "-g",
                "${workspaceFolder}/src/\\*.cpp",
                "${workspaceFolder}/src/\\*.c",
                "-lglfw3dll",
                "-o",
                "${workspaceFolder}/MiniEngine.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "dependsOn": "PCH Compile (Debug)",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "compiler: C:\\msys64\\ucrt64\\bin\\g++.exe"
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file (Release)",
            "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-std=c++20",
                "-I${workspaceFolder}/include",
                "-L${workspaceFolder}/lib",
                "-O3",
                "-s",
                "${workspaceFolder}/src/\\*.cpp",
                "${workspaceFolder}/src/\\*.c",
                "-lglfw3dll",
                "-o",
                "${workspaceFolder}/MiniEngine.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "dependsOn": "PCH Compile (Release)",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "compiler: C:\\msys64\\ucrt64\\bin\\g++.exe"
        }
	]
}